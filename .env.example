# cobalt API instance (self-hosted is recommended)
COBALT_API_URL=http://127.0.0.1:9000/
COBALT_API_KEY=

# Web console
PORT=8787
HOST=0.0.0.0
# Optional, useful when opening the console through a reverse proxy
PUBLIC_ORIGIN=

# Downloads
DEFAULT_DOWNLOAD_DIR=D:\downloads\cobalt
MAX_CONCURRENT_DOWNLOADS=5
